# Ayasofia Sweet — Environment Variables
# =============================================================================
# انسخ هذا الملف إلى .env.local واملأ القيم الحقيقية
# cp .env.example .env.local
#
# .env.local مُستثنى من git (git-ignored) — لا تُضمّن أسرارًا حقيقية هنا أبدًا
# =============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
# من: Supabase Dashboard → Project Settings → API

# Supabase project URL (آمن للـ client)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Anon/Public key — صُمم ليكون عامًا (accessible from browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ⚠️  Service Role Key — سرّي! NEVER expose to browser!
# يتجاوز Row Level Security. يُستخدم فقط في Server Actions عبر lib/supabase/service.ts
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Database ─────────────────────────────────────────────────────────────────
# من: Supabase Dashboard → Project Settings → Database → Connection string
# يُستخدم بواسطة Drizzle Kit للهجرات فقط

# (P2-PERF-3) Production pooler connection_limit. Raised to 10 so the tablefront
# (a distinct IP per guest) + the kitchen's 15s status polls + admin reports can
# run concurrently without queueing on one pooled connection. Keep it below the
# Supabase pooler's per-project caps; migrate/seed still use a single short-lived
# connection so they are unaffected.
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres?connection_limit=10

# ── Monitoring ───────────────────────────────────────────────────────────────
# من: sentry.io → Settings → Projects → Client Keys (DSN)
# اختياري لكن موصى به للإنتاج (spec §12)
# ضع نفس الـ DSN في كلا المتغيرين إذا كنت تستخدم الإنتاج

NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxx@oxxxxxx.ingest.sentry.io/xxxxxxxx
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxx@oxxxxxx.ingest.sentry.io/xxxxxxxx

# ── Application ──────────────────────────────────────────────────────────────
# (Currency is read from settings.currency in Postgres — no env var.)

# Tax rate percentage — DEAD: never read by application code.
# The sole source of truth for tax is settings.tax_rate in the database.
# NEXT_PUBLIC_APP_TAX_RATE=17

# ── Validation ───────────────────────────────────────────────────────────────
# يُستخدم بواسطة scripts/validate-env.ts للتأكد من اكتمال المتغيرات قبل البناء

# RUN_ENV=production  # staging | production

# ── Digital Menu & WiFi Portal (new modules) ─────────────────────────────────

# Salt used to hash guest device ids before storing wifi_sessions — never the
# raw identifier (privacy, C5). Keep this secret; rotate and sessions re-hash.
# WIFI_DEVICE_ID_SALT=change-me

# Captive portal router adapter: mock | mikrotik | unifi (WF-04).
# mock logs and always succeeds (default, works end-to-end without a router).
# mikrotik/unifi are documented stubs until the router model is confirmed.
CAPTIVE_PORTAL_ADAPTER=mock
