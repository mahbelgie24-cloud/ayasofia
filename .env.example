# Ayasofia Sweet — Environment Variables
# =============================================================================
# انسخ هذا الملف إلى .env.local واملأ القيم الحقيقية
# cp .env.example .env.local
#
# .env.local مُستثنى من git (git-ignored) — لا تُضمّن أسرارًا حقيقية هنا أبدًا
# =============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
# من: Supabase Dashboard → Project Settings → API

# Supabase project URL (آمن للـ client)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Anon/Public key — صُمم ليكون عامًا (accessible from browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ⚠️  Service Role Key — سرّي! NEVER expose to browser!
# يتجاوز Row Level Security. يُستخدم فقط في Server Actions عبر lib/supabase/service.ts
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Database ─────────────────────────────────────────────────────────────────
# من: Supabase Dashboard → Project Settings → Database → Connection string
# يُستخدم بواسطة Drizzle Kit للهجرات فقط

DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ── Monitoring ───────────────────────────────────────────────────────────────
# من: sentry.io → Settings → Projects → Client Keys (DSN)
# اختياري لكن موصى به للإنتاج (spec §12)

SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxx@oxxxxxx.ingest.sentry.io/xxxxxxxx

# ── Application ──────────────────────────────────────────────────────────────

# Currency code (ISO 4217)
NEXT_PUBLIC_APP_CURRENCY=ILS

# Tax rate percentage — e.g. 17 for 17% VAT
NEXT_PUBLIC_APP_TAX_RATE=17

# ── Validation ───────────────────────────────────────────────────────────────
# يُستخدم بواسطة scripts/validate-env.ts للتأكد من اكتمال المتغيرات قبل البناء

# RUN_ENV=production  # staging | production
