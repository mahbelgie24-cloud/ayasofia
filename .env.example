# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real credentials (spec §12).

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Project Settings → Database → Connection string) ---
# Used by Drizzle Kit for migrations only.
DATABASE_URL=

# --- Monitoring (optional but recommended, spec §12) ---
SENTRY_DSN=

# --- App ---
NEXT_PUBLIC_APP_CURRENCY=ILS
